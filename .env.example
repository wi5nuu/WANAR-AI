GROQ_MAX_TOKENS=8192
GROQ_MAX_CONTEXT_TOKENS=128000

# ── OpenRouter Provider (ratusan model, AUTO-SWITCH ke model gratis) ──
# Bila model pilihan kena rate-limit/kuota/hilang, provider otomatis pindah ke
# model berakhiran :free (urutan fallback diatur via OPENROUTER_FREE_MODELS).
# Get free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_AUTO_SWITCH_FREE=true
# OPENROUTER_FREE_MODELS=nvidia/nemotron-3-super-120b-a12b:free,openrouter/free,cohere/north-mini-code:free
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_MAX_CONTEXT_TOKENS=131072

