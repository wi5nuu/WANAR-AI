{
  "name": "wanar-ai",
  "version": "1.0.9",
  "description": "Wanar AI v1.0.5 - Professional AI Chat Platform + CLI Agent by Wisnu Alfian Nur Ashar",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "wanar": "bin/wanar.js",
    "wanarai": "bin/wanarai.js"
  },
  "files": [
    "src/",
    "bin/",
    "config/",
    "scripts/",
    "client/dist/",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "cli": "node src/cli.js",
    "web": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "dev": "node --watch src/server.js",
    "analytics": "node src/tools/health-cli.js",
    "analytics:legacy": "node src/tools/analytics-cli.js",
    "audit:secrets": "node scripts/secrets-audit.mjs",
    "audit:secrets:staged": "node scripts/secrets-audit.mjs --staged",
    "audit:auth": "node scripts/auth-report.mjs",
    "report:enterprise": "node scripts/enterprise-report.mjs",
    "authorize": "node scripts/authorize.mjs",
    "scope": "node scripts/authorize.mjs list",
    "loadtest": "node scripts/load-test.mjs",
    "inventory": "node scripts/inventory.mjs",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy/deploy.ps1",
    "postinstall": "node scripts/postinstall.js",
    "service:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service/wanar-service.ps1 install",
    "service:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service/wanar-service.ps1 uninstall",
    "service:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service/wanar-service.ps1 status",
    "service:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service/wanar-service.ps1 restart"
  },
  "keywords": [
    "ai",
    "agent",
    "enterprise",
    "openagentic",
    "nvidia",
    "vector",
    "multi-provider",
    "intelligent-routing",
    "context-management",
    "semantic-cache",
    "analytics",
    "chatbot",
    "cli",
    "terminal"
  ],
  "author": "Wisnu Alfian Nur Ashar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisnunugroho21/wanar-ai.git"
  },
  "bugs": {
    "url": "https://github.com/wisnunugroho21/wanar-ai/issues"
  },
  "homepage": "https://github.com/wisnunugroho21/wanar-ai#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "glob": "^13.0.6",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.3.0",
    "html-to-text": "^10.0.0",
    "imapflow": "^2.4.0",
    "inquirer": "^9.2.12",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "mailparser": "^3.9.38",
    "marked": "^18.0.6",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.11",
    "ora": "^7.0.1"
  },
  "optionalDependencies": {
    "pdf-parse": "2.4.5",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "tesseract.js": "^7.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  }
}
