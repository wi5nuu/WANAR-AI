# ============================================
# Wanar AI v2.0 — Enterprise Multi-Provider AI Agent
# by Wisnu Alfian Nur Ashar
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── OpenAgentic Provider (PRIMARY - Unlimited Sonnet 4.5) ──
OPENAGENTIC_API_KEY=sk-9d560121394a8dff5deb16c814011ed5d47364740a3ea6fe7835af06800122a1
OPENAGENTIC_BASE_URL=https://openagentic.id/api/v1
OPENAGENTIC_DEFAULT_MODEL=claude-sonnet-4.5
OPENAGENTIC_MAX_TOKENS=200000

# ── NVIDIA Provider ──
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
# MULTI-KEY: Pisahkan dengan koma untuk auto-failover & load balancing
# NVIDIA_KEYS=nvapi-key1,nvapi-key2,nvapi-key3,nvapi-key4,nvapi-key5
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_MAX_TOKENS=16384

# ── VectorEngine Provider ──
VECTOR_API_KEY=sk-your-vectorengine-api-key-here
VECTOR_BASE_URL=https://api.vectorengine.ai/v1
VECTOR_DEFAULT_MODEL=claude-sonnet-5
VECTOR_MAX_TOKENS=16384

# ── Puter.js Provider (Free) ──
PUTER_ENABLED=true
PUTER_DEFAULT_MODEL=claude-sonnet-5

# ── Anthropic Provider (Direct API) ──
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# ── OpenAI Provider ──
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_MAX_TOKENS=16384
OPENAI_MAX_CONTEXT_TOKENS=128000

# ── Google Gemini Provider (2M Context!) ──
GEMINI_API_KEY=your-gemini-api-key-here
# Alternative: GOOGLE_API_KEY=your-google-api-key-here
GEMINI_DEFAULT_MODEL=gemini-2.0-flash-exp
GEMINI_MAX_TOKENS=8192
GEMINI_MAX_CONTEXT_TOKENS=2000000

# ── Groq Provider (Ultra-Fast LPU Inference) ──
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=8192
GROQ_MAX_CONTEXT_TOKENS=128000

# ── Azure OpenAI Provider (Enterprise with SLA) ──
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEFAULT_MODEL=gpt-4o
AZURE_OPENAI_MAX_TOKENS=16384
AZURE_OPENAI_MAX_CONTEXT_TOKENS=128000

# ── Default Provider ──
# Available: openagentic | anthropic | openai | gemini | groq | azure | nvidia | vector | puter
DEFAULT_PROVIDER=openagentic

# ── Context Window Management ──
CONTEXT_MAX_TURNS=20               # Max putaran percakapan sebelum trimming
CONTEXT_MAX_TOKENS=131072          # Max token input (default DeepSeek V4: 128K)
CONTEXT_ENABLE_SUMMARIZATION=true  # Ringkas history lama jika melebihi batas

# ── RAG (Retrieval-Augmented Generation) ──
RAG_ENABLED=false                   # Aktifkan RAG untuk 100k+ line codebase
RAG_WORKSPACE_DIR=.                 # Direktori project yang akan di-index
RAG_MAX_FILE_SIZE=1048576           # Max file size (bytes) untuk di-index
RAG_CHUNK_SIZE=1000                 # Ukuran chunk per potongan kode
RAG_CHUNK_OVERLAP=100               # Overlap antar chunk
RAG_MAX_RESULTS=5                   # Max hasil retrieval per query

# ── Server ──
PORT=3000
HOST=localhost

# ── Token & Usage Limits ──
DAILY_TOKEN_LIMIT=300000000
DAILY_COST_LIMIT_USD=50

# ── CLI ──
CLI_COLOR_ENABLED=true
CLI_ANIMATION_ENABLED=true
