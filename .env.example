# ── Fireworks AI Provider (Free Tier + Coding Models) ──
FIREWORKS_API_KEY=your-fireworks-api-key-here
# Get free credits at: https://fireworks.ai/
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_DEFAULT_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
FIREWORKS_MAX_TOKENS=16384
