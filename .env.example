# ── Default Provider ──
# Available: openagentic | anthropic | openai | gemini | groq | azure | nvidia | vector | puter | cerebras | sambanova | hyperbolic | huggingface | together | fireworks
DEFAULT_PROVIDER=openagentic

# ── Context Window Management ──
CONTEXT_MAX_TURNS=20               # Max putaran percakapan sebelum trimming
CONTEXT_MAX_TOKENS=131072          # Max token input (default DeepSeek V4: 128K)
CONTEXT_ENABLE_SUMMARIZATION=true  # Ringkas history lama jika melebihi batas

# ── RAG (Retrieval-Augmented Generation) ──
RAG_ENABLED=false                   # Aktifkan RAG untuk 100k+ line codebase
RAG_WORKSPACE_DIR=.                 # Direktori project yang akan di-index
RAG_MAX_FILE_SIZE=1048576           # Max file size (bytes) untuk di-index
RAG_CHUNK_SIZE=1000                 # Ukuran chunk per potongan kode
RAG_CHUNK_OVERLAP=100               # Overlap antar chunk
RAG_MAX_RESULTS=5                   # Max hasil retrieval per query

# ── Server ──
PORT=3000
HOST=localhost
NODE_ENV=production

# ── Security (WAJIB di production) ──
# JWT_SECRET: string acak panjang, MINIMAL 32 karakter. Server akan MENOLAK
# start jika kosong, terlalu pendek, atau masih memakai nilai contoh di bawah
# (karena nilai contoh bersifat publik dan membuat token bisa dipalsukan).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
# Google OAuth Client ID untuk login Google
GOOGLE_CLIENT_ID=
# Origin frontend yang diizinkan (CORS). Kosongkan untuk default localhost.
CORS_ORIGIN=
# Jumlah hop reverse-proxy yang dipercaya untuk menentukan IP klien.
# Di belakang IIS/ARR (lihat web.config) gunakan 1. Set 0 jika Node diekspos
# langsung, agar klien tidak bisa memalsukan IP via X-Forwarded-For.
TRUST_PROXY=1
# Izinkan request keluar ke jaringan privat (loopback/RFC1918). Default false.
# Biarkan false di production: ini yang mencegah SSRF ke layanan internal dan
# endpoint metadata cloud (169.254.169.254).
ALLOW_PRIVATE_NETWORK_FETCH=false
# Batas waktu approval tool berbahaya (ms). Approval bersifat sekali-pakai.
TOOL_APPROVAL_TTL_MS=600000

# ── Auth Audit & Monitoring ──
# Log event auth (JSON lines). Folder logs/ sudah masuk .gitignore.
AUTH_AUDIT_LOG=logs/auth-audit.log
# Ambang & jendela deteksi brute-force
AUTH_FAIL_THRESHOLD=5
AUTH_FAIL_WINDOW_MS=600000
# Cooldown antar-alert (ms) agar tidak spam
AUTH_ALERT_COOLDOWN_MS=300000
# Opsional: URL webhook (Slack/Discord/generic) untuk menerima alert keamanan
SECURITY_ALERT_WEBHOOK=

# ── Security Scan Scope (WAJIB untuk scanning) ──
# Daftar host yang ANDA MILIKI, dipisahkan koma. Hanya host ini yang boleh
# dipindai. Tanpa ini, scanner hanya mengizinkan localhost (default aman).
# CATATAN: cara yang lebih disarankan adalah pakai perintah authorize, karena
# tersimpan dengan alasan + waktu + siapa yang mengotorisasi, dan langsung
# berlaku tanpa restart server:
#   npm run authorize -- add example.com --reason "server staging saya"
#   npm run scope
# Contoh: SCAN_ALLOWED_TARGETS=example.com,api.example.com,203.0.113.10
SCAN_ALLOWED_TARGETS=
SCAN_ALLOW_LOCALHOST=true
# Lokasi file scope otorisasi (default: config/scan-scope.json)
# SCAN_SCOPE_FILE=config/scan-scope.json

# ── Security Scan Stability ──
# Batas konkurensi request (jangan dinaikkan sembarangan — event loop bisa beku)
SCAN_CONCURRENCY=8
# Anggaran waktu total satu scan (ms)
SCAN_DEADLINE_MS=120000
# Timeout per request (ms)
SCAN_REQUEST_TIMEOUT_MS=4000

# ── Desktop Control (cursor mouse lokal) ──
# true = AI boleh menggerakkan cursor/klik di mesin yang menjalankan server
MOUSE_CONTROL_ENABLED=false

# ── Browser Agent (mode terlihat) ──
# true = AI membuka jendela Chromium SUNGGUHAN di layar (bisa ditonton sambil voice call)
BROWSER_VISIBLE=true
# Lama jendela dibiarkan terbuka per navigasi (ms)
BROWSER_KEEP_OPEN_MS=6000

# ── Browser Pool (kecepatan) ──
# false = matikan pool persisten (tiap browser_open launch Chromium baru, lebih lambat)
BROWSER_POOL_ENABLED=true
# Blokir gambar/font/media/analytics agar halaman ringan & cepat dibuka (text/link tetap lengkap)
BROWSER_BLOCK_RESOURCES=true
# Timeout navigasi (ms) dan tutup pool bila idle selama ini (hemat RAM)
BROWSER_NAV_TIMEOUT_MS=30000
BROWSER_IDLE_MS=90000
BROWSER_MAX_PAGES=6
# Pre-warm Chromium saat server start. Di produksi (NODE_ENV=production) defaultnya
# NONAKTIF agar VPS tidak langsung memakan ±300MB RAM; isi true untuk memaksa.
BROWSER_POOL_WARM=false

# ── Bounded Load Test (kapasitas, BUKAN DoS) ──
# Semua nilai di-clamp ke batas ini; test auto-berhenti saat server mulai turun.
LOADTEST_MAX_DURATION_MS=60000
LOADTEST_MAX_RPS=50
LOADTEST_MAX_CONCURRENCY=16
LOADTEST_MAX_ERROR_RATE=0.05
LOADTEST_MAX_LATENCY_MS=2000

# ── Token & Usage Limits ──
DAILY_TOKEN_LIMIT=300000000
DAILY_COST_LIMIT_USD=50

# ── Voice Talk: suara super manusiawi (opsional) ──
# Tanpa ini, voice pakai suara natural browser (Microsoft/Google id-ID) — sudah cukup manusiawi.
# Isi salah satu untuk kualitas seperti manusia asli:
# OPENAI_API_KEY=sk-... (dipakai juga untuk TTS gpt-4o-mini-tts)
# OPENAI_TTS_VOICE=alloy
# ELEVENLABS_API_KEY=... (paling manusiawi, model eleven_multilingual_v2)
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# ── Google Speech-to-Text (untuk CAPTCHA audio) ──
GOOGLE_SPEECH_API_KEY=your-google-speech-api-key-here

# ── CLI ──
CLI_COLOR_ENABLED=true
CLI_ANIMATION_ENABLED=true


# ============================================================
# AUTOMATION — jadwal otomatis & email massal
# Tanpa SMTP_* modul berjalan dalam MODE SIMULASI (email tidak terkirim).
# Untuk Gmail gunakan App Password (Verifikasi 2 langkah wajib aktif).
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nama Anda <anda@perusahaan.co.id>"

# Batas pengaman (opsional)
EMAIL_DAILY_CAP=450          # maks email live per hari (zona waktu WIB)
EMAIL_THROTTLE_MS=1200       # jeda antar email
EMAIL_MAX_RECIPIENTS=1000    # maks penerima per kampanye
EMAIL_MAX_ATTEMPTS=3         # percobaan ulang untuk error sementara
EMAIL_DRY_RUN=false          # true = paksa simulasi walau SMTP terisi
AUTOMATION_TZ=Asia/Jakarta

# --- Keamanan & ketahanan otomasi ---
# Tanpa token, otomasi HANYA bisa diakses dari komputer server (localhost).
# Isi untuk mengizinkan akses dari jaringan (kirim header X-Automation-Token).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
AUTOMATION_TOKEN=

# Job yang terlewat (laptop mati/tidur) masih dikejar jika terlambat <= N jam
AUTOMATION_CATCHUP_HOURS=6
# Lampiran email
EMAIL_MAX_ATTACHMENT_MB=10
EMAIL_MAX_TOTAL_ATTACHMENT_MB=18
EMAIL_MAX_ATTACHMENTS=5

# ============================================================
# KANAL PESAN LAIN (opsional) — tanpa konfigurasi = mode SIMULASI
# ============================================================
# --- Telegram Bot (resmi, gratis) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING=false           # true = pelanggan mendaftar lewat /start, berhenti lewat /stop
TELEGRAM_JOIN_CODE=              # opsional: wajib '/start KODE' agar bot publik tetap privat
TELEGRAM_ALLOWED_CHAT_IDS=       # opsional: hanya chat ini yang boleh berlangganan
TELEGRAM_AI_CHAT_IDS=            # chat ID yang boleh MENGOBROL dengan AI (kosong = AI chat mati)
TELEGRAM_DAILY_CAP=5000

# --- Jadwal Waktu Shalat (Bekasi) — otomatis kirim ke Telegram ---
# Mengambil data dari Aladhan API (gratis, tidak butuh API key).
PRAYER_TIMES_ENABLED=true        # false = matikan fitur ini
PRAYER_TIMES_CITY=Bekasi         # kota untuk jadwal shalat
PRAYER_TIMES_COUNTRY=Indonesia   # negara
PRAYER_TIMES_METHOD=2            # metode hitungan (2=ISNA, umum di Indonesia)
PRAYER_TIMES_SCHEDULE=daily@04:00   # kapan dikirim tiap hari (sebelum Subuh)
PRAYER_TIMES_CHAT_ID=            # chat ID tujuan (kosong = pakai TELEGRAM_AI_CHAT_IDS pertama)
# --- WhatsApp Business Cloud API (resmi, Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=          # template disetujui (1 variabel); wajib untuk pelanggan baru
WHATSAPP_TEMPLATE_LANG=id
WHATSAPP_DEFAULT_COUNTRY_CODE=62
WHATSAPP_DAILY_CAP=250           # sesuai tier akun Meta Anda
# --- Slack / Discord / Teams / Webhook umum (n8n, Zapier, bot sendiri) ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
WEBHOOK_URL=
WEBHOOK_SECRET=                  # tanda tangan HMAC-SHA256 di header X-Wanar-Signature
WEBHOOK_BEARER_TOKEN=

# --- Jurnal Kerja ---
GITHUB_TOKEN=                    # opsional, token hanya-baca: aktivitas repo privat + batas API lebih tinggi
WORKLOG_TZ=Asia/Jakarta

# Hanya SATU instance boleh menjalankan bot Telegram & penjadwal. Set false di instance lain (mis. laptop bila VPS jadi utama).
WANAR_BACKGROUND_JOBS=true

# ---- Email Desk (kirim email dari Telegram + pantau balasan realtime) ----
# Mengirim memakai SMTP_* di atas. Memantau balasan memakai IMAP (IDLE = push).
# IMAP_HOST otomatis diturunkan dari SMTP_HOST (smtp.x -> imap.x); user/pass default = SMTP_USER/SMTP_PASS.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
EMAIL_WATCH=true                 # false = jangan pantau inbox
EMAIL_SIGNATURE=                 # tanda tangan balasan otomatis (default: "Salam, <OWNER_NAME>")
EMAIL_AUTOREPLY_MAX_PER_THREAD=3 # batas balasan otomatis per percakapan
EMAIL_AUTOREPLY_MAX_PER_DAY=30   # batas balasan otomatis per hari

# ---- Brevo (alternatif SMTP): cukup API key v3 ("xkeysib-...") + MAIL_FROM yang sudah terverifikasi di Brevo ----
# Server harus ada di Brevo > SMTP & API > Authorized IPs. Brevo hanya MENGIRIM; balasan masuk ke inbox MAIL_FROM/Reply-To (pantau lewat IMAP_*).
BREVO_API_KEY=

# ---- Clouvia Router (gateway OpenAI-compatible) ----
# Kunci dibuat di https://router.clouvia.id/app/keys (awalan clv_live_). Isi lewat skrip, jangan ditempel di chat.
CLOUVIA_API_KEY=
CLOUVIA_BASE_URL=https://router.clouvia.id/v1
# Hanya model di daftar ini yang boleh dipakai sistem (hemat: akun punya saldo berbayar).
CLOUVIA_MODELS=deepseek-v4.1-flash
CLOUVIA_DEFAULT_MODEL=deepseek-v4.1-flash
