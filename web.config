<?xml version="1.0" encoding="utf-8"?>
<!--
  Wanar AI — hardened IIS configuration (reverse-proxy deployment).

  Assumes the Node.js server runs on http://localhost:3000 (see DEPLOY-IIS.md,
  option B). Copy this file to C:\inetpub\wwwroot\wanar-ai\web.config on the
  server and adjust paths / ports if needed.

  Requires: URL Rewrite module, Application Request Routing (ARR).
-->
<configuration>
  <system.webServer>

    <!-- ── Reverse proxy: all traffic → Node.js on :3000 ─────────────── -->
    <rewrite>
      <rules>
        <!-- 1. Force HTTPS -->
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2. Do not proxy requests for real files under wwwroot -->
        <rule name="ReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- ── Security headers ──────────────────────────────────────────── -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />
        <add name="Content-Security-Policy" value="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; upgrade-insecure-requests" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <remove name="X-Powered-By" />
        <remove name="X-AspNet-Version" />
        <remove name="X-AspNetMvc-Version" />
      </customHeaders>
    </httpProtocol>

    <!-- ── Request filtering / hardening ─────────────────────────────── -->
    <security>
      <requestFiltering removeServerHeader="true">
        <!-- Block TRACE explicitly (Cross-Site Tracing / XST).
             OPTIONS is intentionally left enabled: the SPA needs CORS preflight. -->
        <verbs>
          <add verb="TRACE" allowed="false" />
        </verbs>
        <!-- Limit request size, URL and query length -->
        <requestLimits maxAllowedContentLength="10485760"
                       maxUrl="2048"
                       maxQueryString="2048" />
        <!-- Deny access to sensitive segments -->
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".env" />
          <add segment="node_modules" />
          <add segment="data" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- ── Error responses: never leak stack traces ──────────────────── -->
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />

    <!-- ── Static content caching for built assets ───────────────────── -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
    </staticContent>

  </system.webServer>
</configuration>
