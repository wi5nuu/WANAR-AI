# ============================================
# Wanar AI v1.0.7 — Enterprise Multi-Provider AI Agent
# by Wisnu Alfian Nur Ashar
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
#
# 🎉 NEW IN v1.0.7: 6 FREE AI PROVIDERS ADDED!
# - Cerebras: Ultra-fast (1800 tok/s) Llama 3.3 70B - FREE & UNLIMITED
# - SambaNova: Llama 3.1 405B (largest model) - FREE & UNLIMITED
# - Hyperbolic: DeepSeek V3, Qwen 2.5 72B, Llama 405B - FREE
# - HuggingFace: Thousands of open-source models - FREE (rate limited)
# - Together AI: Llama 405B Turbo + $25 free credit
# - Fireworks AI: Coding-optimized models - FREE tier
#
# Total: 15 AI providers with 120+ models!

# ── OpenAgentic Provider (PRIMARY) ──
OPENAGENTIC_API_KEY=sk-your-openagentic-api-key-here
OPENAGENTIC_BASE_URL=https://openagentic.id/api/v1
OPENAGENTIC_DEFAULT_MODEL=deepseek-v4.1-flash-free
OPENAGENTIC_MAX_TOKENS=200000

# ── NVIDIA Provider ──
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
# MULTI-KEY: Pisahkan dengan koma untuk auto-failover & load balancing
# NVIDIA_KEYS=nvapi-key1,nvapi-key2,nvapi-key3,nvapi-key4,nvapi-key5
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_MAX_TOKENS=16384

